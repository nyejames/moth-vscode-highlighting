{
  "version": "0.2.8",
  "name": "Moth Dependency Clause Highlighting",
  "scopeName": "source.moth.dependency-clauses",
  "injectionSelector": "L:source.moth - meta.template.body.moth - string - comment, L:source.moth.embedded - string - comment",
  "patterns": [
    {
      "include": "#dependency-clause"
    }
  ],
  "repository": {
    "dependency-clause": {
      "patterns": [
        {
          "name": "meta.dependency.clause.moth",
          "begin": "^(\\s*)(@)((?:\\\"(?:\\\\[\\\"\\\\]|[^\\\"\\\\])*\\\"|[A-Za-z0-9_.-]+)(?:[\\\\/](?:\\\"(?:\\\\[\\\"\\\\]|[^\\\"\\\\])*\\\"|[A-Za-z0-9_.-]+))*)(?:(\\s+)(as)(\\s+)([A-Za-z_][A-Za-z0-9_]*))?",
          "beginCaptures": {
            "2": {
              "name": "punctuation.definition.path.begin.moth"
            },
            "3": {
              "name": "meta.path.dependency.moth entity.name.namespace.moth"
            },
            "5": {
              "name": "keyword.other.alias.namespace.moth"
            },
            "7": {
              "name": "entity.name.namespace.alias.moth"
            }
          },
          "end": "(?=^(?!\\s*(?:[A-Za-z_][A-Za-z0-9_]*(?:\\s+as\\s+[A-Za-z_][A-Za-z0-9_]*)?)(?:\\s*,\\s*[A-Za-z_][A-Za-z0-9_]*(?:\\s+as\\s+[A-Za-z_][A-Za-z0-9_]*)?)*\\s*,?\\s*$))|(?<=[^,\\s])\\s*$",
          "patterns": [
            {
              "name": "invalid.illegal.dependency.delimiter.moth",
              "begin": "[\\{\\(\\|:]",
              "end": "$"
            },
            {
              "name": "meta.dependency.selection.alias.moth",
              "match": "\\b([A-Za-z_][A-Za-z0-9_]*)(\\s+)(as)(\\s+)([A-Za-z_][A-Za-z0-9_]*)\\b",
              "captures": {
                "1": {
                  "name": "entity.name.dependency.selection.moth"
                },
                "3": {
                  "name": "keyword.other.alias.selection.moth"
                },
                "5": {
                  "name": "entity.name.dependency.selection.alias.moth"
                }
              }
            },
            {
              "name": "entity.name.dependency.selection.moth",
              "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
            },
            {
              "name": "punctuation.separator.comma.moth",
              "match": ","
            }
          ]
        }
      ]
    }
  }
}
