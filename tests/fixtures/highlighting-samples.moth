-- Source comments use -- until the end of the line.

@core/math as math
@styles/docs navbar, title, section
@docs/pages/home render as render_home,
    content as about_content
@drawing.js draw,
    clear,
    Canvas
@drawing.js as drawing
@project version

$export
@core/math sin, cos

import = 1
export = 2
block = 3
config = 4
group = 5
region = 6

page_title #= "Templates"
page_description #String = "Accepted Moth syntax highlighting."
version_copy #I32 = version
logo #= @assets/logo.svg
font #= @fonts/"Computer Modern.woff2"
page = [@pages/home.mtf]
root = @/

count ~= 0
ratio F64 = 1.5
decimal Dec4 = 12.3456
octet Byte = 255
letter Char = 'A'
text_slice = "escaped\ntext"

message = [:
    Templates create owned strings.
]

circle_img_css #= [$css "inline":
    aspect-ratio: 1/1;
    clip-path: circle(55%);
    border: 3px solid #ddd;
    border-radius: 50%;
    background: url("shape]one.svg");
]

values ~{I32} = {}
names {String} = {"Priya", "Rob"}

Person = |
    name String,
    age I32 = 0,
|

Status ::
    Ready,
    Loading | progress F64 |,
    Failed | message String, code U32 |,
;

$fast_math
increment |value ~I32|:
    inner:
        ~value += 1
    ;
;

identity type Item |value Item| -> Item:
    return value
;

DISPLAY_TEXT must:
    display |This| -> String
;

Label = | text String |

display |this Label| -> String:
    return this.text
;

Label must DISPLAY_TEXT

person ~= Person(name = "Priya", age = 30)
~person.age += 1
person_name = person.display_name()

name, score = pair()
~count, status = next()

if ready:
    inner:
        io.line("ready")
    ;
else
    io.line("waiting")
;

label = if score is:
    < 0 => then "invalid"
    0 => then "zero"
    >= 90 => then "excellent"
    else => then "other"
;

maybe_name String? = none
present_name = if maybe_name is |name| then name else "guest"

fallback = parse_number(text) catch:
    then 0
;

loop 0 to & 10 by 2 |number, ordinal|:
    io.line([: [ordinal]: [number]])
;

loop names |name, index|:
    io.line([: [index]: [name]])
;

loop ~scanner.next_token() is |token|:
    io.line(token)
;

positives {I32} = loop {-2, 1, 3} |item|:
    if item > 0:
        then item
    ;
;

fatal |message String| -> !:
    assert(false, message)
;

card #= [$md:
    # Welcome @#welcome

    Use `code [name] text` only where permitted by the Moth Markdown contract.

    - This is a Markdown bullet. @#install
    1. This is an ordered item.

    **Bold [name]** and *italic* text.
    See @#welcome (Welcome) and @./guide (Guide).

    [$note: This content is discarded, including [balanced] brackets.]
]

layout #= [:
    <h1>[$slot title = "Untitled"]</h1>
    <section>[$slot]</section>
]

[layout:[$in title:Welcome]]

list #= [$before [:<li>], $after [:</li>]: <ul>[$slot]</ul>]
[list: [: Priya] [$fresh: [: Rob]]]

image #= [: <img src="[$slot 1]" alt="[$slot]">]
[image, "logo.png": Moth logo]

[codeblock, $code "moth":
    @html table
    value = [not_a_template]
    sample = "[literal]"
]

[codeblock, $code "js":
    const x = [1, 2, 3];
]

[codeblock, $code "ts":
    const user: { name: string } = { name: "Priya" };
]

[codeblock, $code "py":
    def greet(name: str) -> str:
        return f"Hello, {name}"
]

[codeblock, $code "rust":
    fn main() {
        println!("Hello, world!");
    }
]

[codeblock, $code "bash":
    export PATH="/usr/local/bin:$PATH"
]

[codeblock, $code "text":
    Plain text mode keeps no syntax classes.
]

[$html:
    <h1>Title</h1>
    <p>Paragraph with [name].</p>
]

[$css:
    body {
        color: red;
    }
]

$todo [$md: Review this later.]
~[: Runtime fragment.]
